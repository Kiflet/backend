# Staging's settings: what production's .env holds, with the provider
# sandbox in place of the providers. Compose reads it for the ${...} in the
# compose files, and the app and the sandbox read it as their environment,
# so both sides agree on keys, logins and secrets. Nothing here is a secret:
# every value works with this stack only.

# --- For the compose files ---------------------------------------------------
DOMAIN=kiflet.localhost:8443
# With the characters a generated password has, which a database URL can't
# hold as they are.
DB_PASSWORD=staging/db+pass@word:1=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=staging-grafana-password
# Grafana's alerts, to Mailpit.
GRAFANA_ALERT_EMAIL=ops@kiflet.localhost
GRAFANA_ALERT_FROM=monitoring@kiflet.localhost

# --- The app -----------------------------------------------------------------
LOG_LEVEL=info
APP_NAME=Kiflet
AUTO_MIGRATE=true
# Every change archived, for the point-in-time restore drill.
WAL_ARCHIVE=on
# Also in deployments/staging/metrics_token, which Prometheus sends.
METRICS_TOKEN=staging-metrics-token
BILLING_BANK_DETAILS=Commercial Bank of Ethiopia, account 1000123456789, Kiflet Staging
SUPPORT_EMAIL=support@kiflet.localhost
SUPPORT_PHONE=+251 11 000 0000
SUPPORT_TELEGRAM=kiflet_support
SUPPORT_HOURS=Mon to Sat, 08:00 to 18:00
MAIL_FROM=Kiflet Staging <no-reply@kiflet.localhost>
# The providers are the sandbox's, which production refuses unless told.
ALLOW_MOCK_PROVIDERS=true
SANDBOX_URL=https://sandbox.kiflet.localhost:8443

# Signatures and photos, in Garage, as in production (.env.example). Its
# keys are Garage's format; garage-setup imports the app's.
COMPOSE_PROFILES=garage,rabbitmq,redis,workers
APP_ROLES=web
REDIS_PASSWORD=staging-redis-password
REDIS_URL=redis://:staging-redis-password@redis:6379/0
RABBITMQ_PASSWORD=staging-rabbitmq-password
RABBITMQ_URL=amqp://kiflet:staging-rabbitmq-password@rabbitmq:5672/
GARAGE_RPC_SECRET=85b454c3c3df677987d07fa32ceb8767cfce5a979455f80f2faf3aa3f22e51f7
GARAGE_ADMIN_TOKEN=674eb0783bad7f77c01f879b7c09e9aa6770c2d4032d2a59
STORAGE_TYPE=s3
S3_ENDPOINT=http://garage:3900
S3_FORCE_PATH_STYLE=true
S3_BUCKET=kiflet
S3_REGION=garage
S3_ACCESS_KEY=GKce381cc9bfcceefe92a1350d
S3_SECRET_KEY=708d43dc57d37cd5cf878aa712c741580564e75ef494f47cb21aab056af89de9
S3_USE_SSL=false

# Email, to Mailpit.
MAIL_PROVIDER=smtp
SMTP_ADDR=mailpit:1025

# --- The providers, played by the sandbox ------------------------------------
# The app calls them on the internal network. Their pages, and the sandbox's
# calls to the app, go through Caddy over HTTPS, as with the real ones.
SMS_PROVIDER=ethiotelecom
ETHIO_TELECOM_API_URL=http://sandbox:8091/ethiotelecom
ETHIO_TELECOM_API_KEY=staging-ethio-telecom-key
ETHIO_TELECOM_SENDER_ID=KIFLET
SMS_NUMBER=6060
SMS_INBOUND_SECRET=staging-sms-webhook-secret

PAYMENT_PROVIDER=telebirr,cbebirr
TELEBIRR_API_URL=http://sandbox:8091/telebirr
TELEBIRR_CHECKOUT_URL=https://sandbox.kiflet.localhost:8443/telebirr/checkout?
TELEBIRR_FABRIC_APP_ID=staging-fabric-app
TELEBIRR_APP_SECRET=staging-telebirr-app-secret
TELEBIRR_MERCHANT_APP_ID=1100000000000001
TELEBIRR_MERCHANT_CODE=900001
# Written by the sandbox-keys job, as a provider's files would sit in
# deployments/secrets/.
TELEBIRR_PRIVATE_KEY_FILE=/run/secrets/merchant_private.pem
TELEBIRR_PUBLIC_KEY_FILE=/run/secrets/telebirr_public.pem

CBEBIRR_MERCHANT_ID=100100
CBEBIRR_CALLBACK_USERNAME=cbebirr
CBEBIRR_CALLBACK_PASSWORD=staging-cbebirr-password
