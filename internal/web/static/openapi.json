{
  "openapi": "3.1.0",
  "info": {
    "title": "Kiflet API",
    "version": "1",
    "description": "Book and follow a company's shipments from its own systems. Every request sends one of the company's API keys, made under Settings → API keys: `Authorization: Bearer kf_…`. A key acts for the whole company with the dashboard's rules, and what it does is recorded under the key's name in each shipment's history.\n\nEach key may make 300 requests a minute; past that, requests are answered 429, with `Retry-After`, until the minute is over. Times are RFC 3339 and answered in UTC. Weights are in kilograms and values in birr.\n\nAn error is answered with its HTTP status and `{\"error\": {\"code\": …, \"message\": …, \"fields\": …, \"request_id\": …}}`. `code` is in lowercase snake case (`validation_error`, `not_found`); `message` is written to be shown to a person; `fields` names every field at fault, each with its message; `request_id` is the answer's `X-Request-Id`, to quote when asking for help.\n\nWebhooks tell a company's system when its shipments change, without asking: an admin adds an address and the events it wants under Settings → Webhooks. Each is a POST of a `WebhookMessage`, signed as Standard Webhooks (https://www.standardwebhooks.com) describes: `webhook-id` (the same when a message is sent again), `webhook-timestamp` and `webhook-signature`. Answer 2xx within 10 seconds; anything else is tried again after 1 and 5 minutes, 30 minutes, then 2, 6 and 12 hours."
  },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "apiKey": [] }],
  "paths": {
    "/shipments": {
      "get": {
        "operationId": "listShipments",
        "summary": "List shipments, newest first unless sorted otherwise",
        "parameters": [
          { "name": "status", "in": "query", "description": "One status, or several separated by commas.", "schema": { "type": "string", "examples": ["in_transit,delayed"] } },
          { "name": "driver_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "priority", "in": "query", "schema": { "$ref": "#/components/schemas/Priority" } },
          { "name": "q", "in": "query", "description": "Searches the tracking number, the customer's and receiver's names and phones, and the driver's name.", "schema": { "type": "string" } },
          { "name": "created_from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "created_to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["created_desc", "created_asc", "updated_desc", "eta_asc", "eta_desc", "status", "priority", "customer", "tracking"], "default": "created_desc" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } }
        ],
        "responses": {
          "200": {
            "description": "A page of shipments",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["data", "page", "per_page", "total"],
              "properties": {
                "data": { "type": "array", "items": { "$ref": "#/components/schemas/Shipment" } },
                "page": { "type": "integer" },
                "per_page": { "type": "integer" },
                "total": { "type": "integer", "description": "How many shipments match, on every page." }
              }
            } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createShipment",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "summary": "Book a shipment",
        "description": "Checked as the booking form checks it, and the customer is texted as from the form. With `driver_id`, the shipment is assigned at once. Without `estimated_delivery`, the arrival is estimated from the route.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ShipmentBooking" } } } },
        "responses": {
          "201": { "description": "Booked. `Location` is the shipment's address in the API.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Shipment" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "402": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/shipments/{ref}": {
      "parameters": [{ "$ref": "#/components/parameters/Ref" }],
      "get": {
        "operationId": "getShipment",
        "summary": "One shipment",
        "responses": {
          "200": { "description": "The shipment", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Shipment" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "operationId": "updateShipment",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "summary": "Change a booking",
        "description": "A field left out stays as it is. An object that is sent replaces the whole of what it names: send a destination's city and address together. `receiver`, `planned_pickup` and `estimated_delivery` can be sent as null to remove them; a null `estimated_delivery` goes back to the estimate from the route. The driver is changed with `/assign`.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ShipmentChange" } } } },
        "responses": {
          "200": { "description": "The shipment as changed", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Shipment" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "412": { "$ref": "#/components/responses/ShipmentVersionMismatch" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/shipments/{ref}/assign": {
      "parameters": [{ "$ref": "#/components/parameters/Ref" }],
      "post": {
        "operationId": "assignShipment",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "summary": "Assign a driver, change the driver, or take the driver off",
        "description": "The driver is texted as from the dashboard. Without `vehicle_id`, the driver's usual vehicle goes. A null or empty `driver_id` takes the shipment back to pending, if it hasn't left.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "driver_id": { "type": ["string", "null"], "format": "uuid" },
            "vehicle_id": { "type": "string", "format": "uuid" }
          }
        } } } },
        "responses": {
          "200": { "description": "The shipment as assigned", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Shipment" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "402": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "412": { "$ref": "#/components/responses/ShipmentVersionMismatch" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/shipments/{ref}/cancel": {
      "parameters": [{ "$ref": "#/components/parameters/Ref" }],
      "post": {
        "operationId": "cancelShipment",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "summary": "Cancel a shipment",
        "description": "Before it leaves, the reasons are customer_request, duplicate, address_problem, cargo_unavailable, payment_problem and other. On the road, they are recipient_refused, returned_to_origin, cargo_lost_damaged, customer_request, address_problem, payment_problem and other.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": { "type": "string", "enum": ["customer_request", "duplicate", "address_problem", "cargo_unavailable", "payment_problem", "recipient_refused", "returned_to_origin", "cargo_lost_damaged", "other"] },
            "note": { "type": "string", "maxLength": 1000 }
          }
        } } } },
        "responses": {
          "200": { "description": "The shipment, cancelled", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Shipment" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "412": { "$ref": "#/components/responses/ShipmentVersionMismatch" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/shipments/{ref}/events": {
      "parameters": [{ "$ref": "#/components/parameters/Ref" }],
      "get": {
        "operationId": "shipmentEvents",
        "summary": "A shipment's history, oldest first, and where its truck was last seen",
        "responses": {
          "200": {
            "description": "The history",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["data", "last_position"],
              "properties": {
                "data": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } },
                "last_position": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "object", "required": ["lat", "lng", "recorded_at"], "properties": {
                      "lat": { "type": "number" }, "lng": { "type": "number" }, "recorded_at": { "type": "string", "format": "date-time" }
                    } }
                  ]
                }
              }
            } } }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/drivers": {
      "get": {
        "operationId": "listDrivers",
        "summary": "List the company's drivers",
        "parameters": [
          { "name": "active", "in": "query", "description": "false lists deactivated drivers too.", "schema": { "type": "boolean", "default": true } },
          { "name": "q", "in": "query", "description": "Searches names and phones.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The drivers",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["data"],
              "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Driver" } } }
            } } }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "webhooks": {
    "shipment.created": {
      "post": {
        "operationId": "shipmentCreated",
        "summary": "A shipment is booked, from the dashboard, a CSV file or the API",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookMessage" } } } },
        "responses": { "2XX": { "description": "Received. Anything else is tried again." } }
      }
    },
    "shipment.status_changed": {
      "post": {
        "operationId": "shipmentStatusChanged",
        "summary": "A shipment's status changes; data.event has from_status and to_status",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookMessage" } } } },
        "responses": { "2XX": { "description": "Received. Anything else is tried again." } }
      }
    },
    "shipment.delivered": {
      "post": {
        "operationId": "shipmentDelivered",
        "summary": "A shipment is delivered; sent as well as its status change",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookMessage" } } } },
        "responses": { "2XX": { "description": "Received. Anything else is tried again." } }
      }
    },
    "shipment.issue_reported": {
      "post": {
        "operationId": "shipmentIssueReported",
        "summary": "The driver reports a problem (as well as the status change), or the receiver does on the confirmation page (event type customer_issue)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookMessage" } } } },
        "responses": { "2XX": { "description": "Received. Anything else is tried again." } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": { "type": "http", "scheme": "bearer", "description": "A key from Settings → API keys. It starts with kf_." }
    },
    "headers": {
      "ETag": { "description": "The record's version, quoted (\"3\"). Send it back as If-Match to change the record only if no one has since.", "schema": { "type": "string" } }
    },
    "parameters": {
      "IfMatch": { "name": "If-Match", "in": "header", "description": "The ETag of the copy the change was made from. When the record has changed since, the change is refused 412 with the record as it is now.", "schema": { "type": "string" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "description": "A key of the caller's choosing, one per booking. Sent again within 24 hours with the same request, it gets the first answer without booking again, marked Idempotent-Replayed: true; with another request, 422 idempotency_key_reused; while the first still runs, 409 idempotency_key_in_flight. Only a success is kept.", "schema": { "type": "string", "minLength": 1, "maxLength": 255} },
      "Ref": { "name": "ref", "in": "path", "required": true, "description": "The shipment's tracking number or its id.", "schema": { "type": "string" } }
    },
    "responses": {
      "Error": {
        "description": "An error. 400: the request is wrong (validation_error). 401: no working key (unauthorized). 402: a plan limit (plan_limit). 403: the company is suspended or read-only until an invoice is paid (forbidden). 404: no such shipment for this company (not_found). 409: the shipment is in a status that doesn't allow it (conflict). 429: too many requests (rate_limited). 409 also: the first request with this Idempotency-Key is still running (idempotency_key_in_flight). 412: the shipment changed since the If-Match (version_mismatch). 422: an Idempotency-Key sent again with another request (idempotency_key_reused).",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ShipmentVersionMismatch": { "description": "The shipment has changed since the version in If-Match (version_mismatch). `current` is the shipment as it is now, and the ETag its version.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Error" }, { "type": "object", "required": ["current"], "properties": { "current": { "$ref": "#/components/schemas/Shipment" } } }]} } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "description": "Stable, in lowercase snake case: validation_error, unauthorized, plan_limit, forbidden, not_found, conflict, rate_limited, internal, and more precise ones an operation names. Open: a client treats one it doesn't know by the status.", "examples": ["not_found"] },
              "message": { "type": "string", "description": "What went wrong, for the person using the product." },
              "fields": { "type": "object", "description": "Every invalid field at once, with its message.", "additionalProperties": { "type": "string" } },
              "request_id": { "type": "string", "description": "The request's ID, as in the answer's X-Request-Id, to quote when asking for help." }
            }
          }
        }
      },
      "Status": { "type": "string", "enum": ["pending", "assigned", "in_transit", "delayed", "arrived", "delivered", "issue", "cancelled"] },
      "Priority": { "type": "string", "enum": ["normal", "high", "urgent"] },
      "Place": {
        "type": "object",
        "additionalProperties": false,
        "required": ["city", "address"],
        "properties": {
          "city": { "type": "string", "description": "A town the service knows, such as Addis Ababa or Adama." },
          "address": { "type": "string" },
          "lat": { "type": ["number", "null"], "description": "Sent with lng to pin the place; otherwise the town's centre." },
          "lng": { "type": ["number", "null"] }
        }
      },
      "Party": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "phone"],
        "properties": {
          "name": { "type": "string" },
          "phone": { "type": "string", "description": "An Ethiopian mobile number, 09… or +251…" }
        }
      },
      "Cargo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "weight_kg": { "type": "number", "minimum": 0 },
          "value_santim": { "type": "integer", "format": "int64", "minimum": 0, "description": "What the cargo is worth, in santim (100 to the birr); 0 when not given." },
          "pieces": { "type": "integer", "minimum": 0, "maximum": 1000000, "description": "How many pieces the load is; 0 when not counted." },
          "unit": { "type": "string", "maxLength": 30, "description": "What the pieces are, e.g. bales. Only with pieces." }
        }
      },
      "Shipment": {
        "type": "object",
        "required": ["id", "tracking_number", "status", "priority", "origin", "destination", "customer", "receiver", "cargo", "tracking_url", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "tracking_number": { "type": "string" },
          "status": { "$ref": "#/components/schemas/Status" },
          "status_reason": { "type": "string", "description": "Why it is delayed, has an issue or was cancelled." },
          "priority": { "$ref": "#/components/schemas/Priority" },
          "origin": { "$ref": "#/components/schemas/Place" },
          "destination": { "$ref": "#/components/schemas/Place" },
          "customer": { "$ref": "#/components/schemas/Party" },
          "receiver": { "description": "Who takes delivery, when that isn't the customer.", "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/Party" }] },
          "cargo": { "$ref": "#/components/schemas/Cargo" },
          "instructions": { "type": "string" },
          "driver_id": { "type": ["string", "null"], "format": "uuid" },
          "vehicle_id": { "type": ["string", "null"], "format": "uuid" },
          "planned_pickup": { "type": ["string", "null"], "format": "date-time" },
          "estimated_delivery": { "type": ["string", "null"], "format": "date-time" },
          "picked_up_at": { "type": ["string", "null"], "format": "date-time" },
          "delivered_at": { "type": ["string", "null"], "format": "date-time" },
          "receipt_confirmed": { "type": "boolean", "description": "The receiver confirmed the delivery from the link they were texted." },
          "tracking_url": { "type": "string", "format": "uri", "description": "The public tracking page." },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ShipmentChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "priority": { "$ref": "#/components/schemas/Priority" },
          "origin": { "$ref": "#/components/schemas/Place" },
          "destination": { "$ref": "#/components/schemas/Place" },
          "customer": { "$ref": "#/components/schemas/Party" },
          "receiver": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/Party" }] },
          "cargo": { "$ref": "#/components/schemas/Cargo" },
          "instructions": { "type": "string" },
          "planned_pickup": { "type": ["string", "null"], "format": "date-time" },
          "estimated_delivery": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "ShipmentBooking": {
        "allOf": [
          { "$ref": "#/components/schemas/ShipmentChange" },
          {
            "type": "object",
            "required": ["origin", "destination", "customer"],
            "properties": {
              "driver_id": { "type": "string", "format": "uuid", "description": "Assign at once." },
              "vehicle_id": { "type": "string", "format": "uuid" }
            }
          }
        ]
      },
      "Event": {
        "type": "object",
        "required": ["type", "source", "actor", "at"],
        "properties": {
          "type": { "type": "string", "description": "created, edited, assigned, unassigned, status_changed, note, message, pod_recorded, pod_held, pod_accepted, pod_dismissed, customer_confirmed, customer_issue and others." },
          "from_status": { "type": "string" },
          "to_status": { "type": "string" },
          "reason": { "type": "string" },
          "note": { "type": "string" },
          "source": { "type": "string", "enum": ["dashboard", "app", "sms", "system", "customer", "api"] },
          "actor": { "type": "string", "description": "Who did it: a person, \"System\", or \"API: \" and a key's name." },
          "lat": { "type": ["number", "null"] },
          "lng": { "type": ["number", "null"] },
          "at": { "type": "string", "format": "date-time" }
        }
      },
      "WebhookMessage": {
        "type": "object",
        "required": ["type", "timestamp", "data"],
        "properties": {
          "type": { "type": "string", "enum": ["shipment.created", "shipment.status_changed", "shipment.delivered", "shipment.issue_reported", "test"] },
          "timestamp": { "type": "string", "format": "date-time", "description": "When it happened." },
          "data": {
            "type": "object",
            "description": "The shipment just after the change, and what happened. A test carries a message instead.",
            "properties": {
              "shipment": { "$ref": "#/components/schemas/Shipment" },
              "event": { "$ref": "#/components/schemas/Event" }
            }
          }
        }
      },
      "Driver": {
        "type": "object",
        "required": ["id", "name", "phone", "active", "vehicle_plate", "active_shipments", "last_sync_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "phone": { "type": "string" },
          "active": { "type": "boolean" },
          "vehicle_plate": { "type": "string" },
          "active_shipments": { "type": "integer" },
          "last_sync_at": { "type": ["string", "null"], "format": "date-time", "description": "When the driver's app last reached the server." }
        }
      }
    }
  }
}
