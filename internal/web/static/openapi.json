{
  "components": {
    "headers": {
      "ETag": {
        "description": "The record's version, quoted (\"3\"). Send it back as If-Match to change the record only if no one has since.",
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "description": "A key of the caller's choosing, one per booking. Sent again within 24 hours with the same request, it gets the first answer without booking again, marked Idempotent-Replayed: true; with another request, 422 idempotency_key_reused; while the first still runs, 409 idempotency_key_in_flight. Only a success is kept.",
        "in": "header",
        "name": "Idempotency-Key",
        "schema": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "IfMatch": {
        "description": "The ETag of the copy the change was made from. When the record has changed since, the change is refused 412 with the record as it is now.",
        "in": "header",
        "name": "If-Match",
        "schema": {
          "type": "string"
        }
      },
      "Ref": {
        "description": "The shipment's tracking number or its id.",
        "in": "path",
        "name": "ref",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "An error. 400: the request is wrong (validation_error). 401: no working key (unauthorized). 402: a plan limit (plan_limit). 403: the company is suspended or read-only until an invoice is paid (forbidden). 404: no such shipment for this company (not_found). 409: the shipment is in a status that doesn't allow it (conflict). 403 tenant_suspended: the company is paused (a driver's app keeps everything and tries later). 413 too_large: the request is larger than the server takes (send less at a time). 429: too many requests (rate_limited). 409 also: the first request with this Idempotency-Key is still running (idempotency_key_in_flight). 412: the shipment changed since the If-Match (version_mismatch). 422: an Idempotency-Key sent again with another request (idempotency_key_reused)."
      },
      "ShipmentVersionMismatch": {
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "properties": {
                    "current": {
                      "$ref": "#/components/schemas/Shipment"
                    }
                  },
                  "required": [
                    "current"
                  ],
                  "type": "object"
                }
              ]
            }
          }
        },
        "description": "The shipment has changed since the version in If-Match (version_mismatch). `current` is the shipment as it is now, and the ETag its version.",
        "headers": {
          "ETag": {
            "$ref": "#/components/headers/ETag"
          }
        }
      }
    },
    "schemas": {
      "Cargo": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "pieces": {
            "description": "How many pieces the load is; 0 when not counted.",
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer"
          },
          "unit": {
            "description": "What the pieces are, e.g. bales. Only with pieces.",
            "maxLength": 30,
            "type": "string"
          },
          "value_santim": {
            "description": "What the cargo is worth, in santim (100 to the birr); 0 when not given.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "weight_kg": {
            "minimum": 0,
            "type": "number"
          }
        },
        "type": "object"
      },
      "Code": {
        "description": "A code with its words for the office, in the language of Accept-Language (English or Amharic; English without it). Act on the code and show the label; show a code you don't know by its label.",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "label"
        ],
        "type": "object"
      },
      "Driver": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "active_shipments": {
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "last_sync_at": {
            "description": "When the driver's app last reached the server.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "vehicle_plate": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "active",
          "vehicle_plate",
          "active_shipments",
          "last_sync_at"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Stable, in lowercase snake case: validation_error, unauthorized, plan_limit, forbidden, not_found, conflict, rate_limited, internal, and more precise ones an operation names. Open: a client treats one it doesn't know by the status.",
                "examples": [
                  "not_found"
                ],
                "type": "string"
              },
              "fields": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Every invalid field at once, with its message.",
                "type": "object"
              },
              "message": {
                "description": "What went wrong, for the person using the product.",
                "type": "string"
              },
              "request_id": {
                "description": "The request's ID, as in the answer's X-Request-Id, to quote when asking for help.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Event": {
        "properties": {
          "actor": {
            "description": "Who did it: a person, \"System\", or \"API: \" and a key's name.",
            "type": "string"
          },
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "from_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Code"
              },
              {
                "type": "null"
              }
            ]
          },
          "lat": {
            "type": [
              "number",
              "null"
            ]
          },
          "lng": {
            "type": [
              "number",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Code"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "enum": [
              "dashboard",
              "app",
              "sms",
              "system",
              "customer",
              "api"
            ],
            "type": "string"
          },
          "to_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Code"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "description": "created, edited, assigned, unassigned, status_changed, note, message, pod_recorded, pod_held, pod_accepted, pod_dismissed, customer_confirmed, customer_issue and others.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "source",
          "actor",
          "at"
        ],
        "type": "object"
      },
      "Party": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "description": "An Ethiopian mobile number, 09… or +251…",
            "type": "string"
          }
        },
        "required": [
          "name",
          "phone"
        ],
        "type": "object"
      },
      "Place": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string"
          },
          "city": {
            "description": "A town the service knows, such as Addis Ababa or Adama.",
            "type": "string"
          },
          "lat": {
            "description": "Sent with lng to pin the place; otherwise the town's centre.",
            "type": [
              "number",
              "null"
            ]
          },
          "lng": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "city",
          "address"
        ],
        "type": "object"
      },
      "Priority": {
        "enum": [
          "normal",
          "high",
          "urgent"
        ],
        "type": "string"
      },
      "Shipment": {
        "properties": {
          "actions": {
            "description": "The operations the shipment allows now: update, assign, unassign and cancel. Show what this allows; open, so another may come.",
            "examples": [
              [
                "update",
                "assign",
                "cancel"
              ]
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cargo": {
            "$ref": "#/components/schemas/Cargo"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/Party"
          },
          "delivered_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "destination": {
            "$ref": "#/components/schemas/Place"
          },
          "driver_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "estimated_delivery": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/Place"
          },
          "picked_up_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "planned_pickup": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "$ref": "#/components/schemas/Code",
            "description": "normal, high or urgent."
          },
          "receipt_confirmed": {
            "description": "The receiver confirmed the delivery from the link they were texted.",
            "type": "boolean"
          },
          "receiver": {
            "description": "Who takes delivery, when that isn't the customer.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Party"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/Code",
            "description": "pending, assigned, in_transit, delayed, arrived, delivered, issue or cancelled."
          },
          "status_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Code"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why it is delayed, has an issue or was cancelled."
          },
          "tracking_number": {
            "type": "string"
          },
          "tracking_url": {
            "description": "The public tracking page.",
            "format": "uri",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "vehicle_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "description": "Raised by every change; the ETag, for If-Match.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "tracking_number",
          "status",
          "priority",
          "origin",
          "destination",
          "customer",
          "receiver",
          "cargo",
          "tracking_url",
          "actions",
          "version",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ShipmentBooking": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ShipmentChange"
          },
          {
            "properties": {
              "driver_id": {
                "description": "Assign at once.",
                "format": "uuid",
                "type": "string"
              },
              "vehicle_id": {
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "origin",
              "destination",
              "customer"
            ],
            "type": "object"
          }
        ]
      },
      "ShipmentChange": {
        "additionalProperties": false,
        "properties": {
          "cargo": {
            "$ref": "#/components/schemas/Cargo"
          },
          "customer": {
            "$ref": "#/components/schemas/Party"
          },
          "destination": {
            "$ref": "#/components/schemas/Place"
          },
          "estimated_delivery": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "instructions": {
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/Place"
          },
          "planned_pickup": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "receiver": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Party"
              }
            ]
          }
        },
        "type": "object"
      },
      "WebhookMessage": {
        "properties": {
          "data": {
            "description": "The shipment just after the change, and what happened. A test carries a message instead.",
            "properties": {
              "event": {
                "$ref": "#/components/schemas/Event"
              },
              "shipment": {
                "$ref": "#/components/schemas/Shipment"
              }
            },
            "type": "object"
          },
          "timestamp": {
            "description": "When it happened.",
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "enum": [
              "shipment.created",
              "shipment.status_changed",
              "shipment.delivered",
              "shipment.issue_reported",
              "test"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "timestamp",
          "data"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKey": {
        "description": "A key from Settings → API keys. It starts with kf_.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Book and follow a company's shipments from its own systems. Every request sends one of the company's API keys, made under Settings → API keys: `Authorization: Bearer kf_…`. A key acts for the whole company with the dashboard's rules, and what it does is recorded under the key's name in each shipment's history.\n\nEach key may make 300 requests a minute; past that, requests are answered 429, with `Retry-After`, until the minute is over. Times are RFC 3339 and answered in UTC. Weights are in kilograms and values in santim.\n\nA code comes with its words, `{\"code\": \"in_transit\", \"label\": \"In transit\"}`, in the language `Accept-Language` asks for (English or Amharic; English without it): act on the code, show the label, and show a code you don't know by its label. A shipment's `actions` are the operations it allows now; show what they allow rather than working it out.\n\nAn error is answered with its HTTP status and `{\"error\": {\"code\": …, \"message\": …, \"fields\": …, \"request_id\": …}}`. `code` is in lowercase snake case (`validation_error`, `not_found`); `message` is written to be shown to a person; `fields` names every field at fault, each with its message; `request_id` is the answer's `X-Request-Id`, to quote when asking for help.\n\nWebhooks tell a company's system when its shipments change, without asking: an admin adds an address and the events it wants under Settings → Webhooks. Each is a POST of a `WebhookMessage`, signed as Standard Webhooks (https://www.standardwebhooks.com) describes: `webhook-id` (the same when a message is sent again), `webhook-timestamp` and `webhook-signature`. Answer 2xx within 10 seconds; anything else is tried again after 1 and 5 minutes, 30 minutes, then 2, 6 and 12 hours.",
    "title": "Kiflet API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/drivers": {
      "get": {
        "operationId": "listDrivers",
        "parameters": [
          {
            "description": "false lists deactivated drivers too.",
            "in": "query",
            "name": "active",
            "schema": {
              "default": true,
              "type": "boolean"
            }
          },
          {
            "description": "Searches names and phones.",
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Driver"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The drivers"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "List the company's drivers"
      }
    },
    "/openapi.json": {
      "get": {
        "description": "This document, as far as the public operations go, in JSON.",
        "operationId": "getPublicSpecification",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The specification"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [],
        "summary": "The public operations' specification"
      }
    },
    "/shipments": {
      "get": {
        "operationId": "listShipments",
        "parameters": [
          {
            "description": "One status, or several separated by commas.",
            "in": "query",
            "name": "status",
            "schema": {
              "examples": [
                "in_transit,delayed"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "driver_id",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "priority",
            "schema": {
              "$ref": "#/components/schemas/Priority"
            }
          },
          {
            "description": "Searches the tracking number, the customer's and receiver's names and phones, and the driver's name.",
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "created_from",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "created_to",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "default": "created_desc",
              "enum": [
                "created_desc",
                "created_asc",
                "updated_desc",
                "eta_asc",
                "eta_desc",
                "status",
                "priority",
                "customer",
                "tracking"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Shipment"
                      },
                      "type": "array"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "per_page": {
                      "type": "integer"
                    },
                    "total": {
                      "description": "How many shipments match, on every page.",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "page",
                    "per_page",
                    "total"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "A page of shipments"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "List shipments, newest first unless sorted otherwise"
      },
      "post": {
        "description": "Checked as the booking form checks it, and the customer is texted as from the form. With `driver_id`, the shipment is assigned at once. Without `estimated_delivery`, the arrival is estimated from the route.",
        "operationId": "createShipment",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShipmentBooking"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment"
                }
              }
            },
            "description": "Booked. `Location` is the shipment's address in the API.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Book a shipment"
      }
    },
    "/shipments/{ref}": {
      "get": {
        "operationId": "getShipment",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment"
                }
              }
            },
            "description": "The shipment",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "One shipment"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/Ref"
        }
      ],
      "patch": {
        "description": "A field left out stays as it is. An object that is sent replaces the whole of what it names: send a destination's city and address together. `receiver`, `planned_pickup` and `estimated_delivery` can be sent as null to remove them; a null `estimated_delivery` goes back to the estimate from the route. The driver is changed with `/assign`.",
        "operationId": "updateShipment",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShipmentChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment"
                }
              }
            },
            "description": "The shipment as changed",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "412": {
            "$ref": "#/components/responses/ShipmentVersionMismatch"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Change a booking"
      }
    },
    "/shipments/{ref}/assign": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Ref"
        }
      ],
      "post": {
        "description": "The driver is texted as from the dashboard. Without `vehicle_id`, the driver's usual vehicle goes. A null or empty `driver_id` takes the shipment back to pending, if it hasn't left.",
        "operationId": "assignShipment",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "driver_id": {
                    "format": "uuid",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "vehicle_id": {
                    "format": "uuid",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment"
                }
              }
            },
            "description": "The shipment as assigned",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "412": {
            "$ref": "#/components/responses/ShipmentVersionMismatch"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Assign a driver, change the driver, or take the driver off"
      }
    },
    "/shipments/{ref}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Ref"
        }
      ],
      "post": {
        "description": "Before it leaves, the reasons are customer_request, duplicate, address_problem, cargo_unavailable, payment_problem and other. On the road, they are recipient_refused, returned_to_origin, cargo_lost_damaged, customer_request, address_problem, payment_problem and other.",
        "operationId": "cancelShipment",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "note": {
                    "maxLength": 1000,
                    "type": "string"
                  },
                  "reason": {
                    "enum": [
                      "customer_request",
                      "duplicate",
                      "address_problem",
                      "cargo_unavailable",
                      "payment_problem",
                      "recipient_refused",
                      "returned_to_origin",
                      "cargo_lost_damaged",
                      "other"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment"
                }
              }
            },
            "description": "The shipment, cancelled",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "412": {
            "$ref": "#/components/responses/ShipmentVersionMismatch"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Cancel a shipment"
      }
    },
    "/shipments/{ref}/events": {
      "get": {
        "operationId": "shipmentEvents",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      },
                      "type": "array"
                    },
                    "last_position": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "properties": {
                            "lat": {
                              "type": "number"
                            },
                            "lng": {
                              "type": "number"
                            },
                            "recorded_at": {
                              "format": "date-time",
                              "type": "string"
                            }
                          },
                          "required": [
                            "lat",
                            "lng",
                            "recorded_at"
                          ],
                          "type": "object"
                        }
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "last_position"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The history"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "A shipment's history, oldest first, and where its truck was last seen"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/Ref"
        }
      ]
    }
  },
